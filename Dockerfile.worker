# ─── Arrivarangam Task Worker ─────────────────────────────────────────────────
# Same image as API but runs worker.js entry point
# Deploy as a separate Railway service: starts with different CMD

FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache openssl

# ─── Dependencies ─────────────────────────────────────────────────────────────
FROM base AS deps
COPY package.json package-lock.json* ./
COPY packages/config/package.json ./packages/config/
COPY packages/db/package.json ./packages/db/
COPY packages/types/package.json ./packages/types/
COPY apps/api/package.json ./apps/api/

RUN npm ci --workspace=apps/api --workspace=packages/config --workspace=packages/db --workspace=packages/types

# ─── Builder ──────────────────────────────────────────────────────────────────
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npx prisma generate --schema=packages/db/prisma/schema.prisma

RUN npm run build --workspace=packages/config
RUN npm run build --workspace=packages/types
RUN npm run build --workspace=packages/db
RUN npm run build --workspace=apps/api

# ─── Runner ───────────────────────────────────────────────────────────────────
FROM base AS runner
ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/config/dist ./packages/config/dist
COPY --from=builder /app/packages/types/dist ./packages/types/dist
COPY --from=builder /app/packages/db/dist ./packages/db/dist
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/packages/db/prisma ./packages/db/prisma
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

COPY --from=builder /app/package.json ./
COPY --from=builder /app/packages/config/package.json ./packages/config/
COPY --from=builder /app/packages/types/package.json ./packages/types/
COPY --from=builder /app/packages/db/package.json ./packages/db/
COPY --from=builder /app/apps/api/package.json ./apps/api/

# Worker has no exposed port — it's a background queue consumer
# WORKER_CONCURRENCY controls parallel job processing (default: 3)
ENV WORKER_CONCURRENCY=3

CMD ["node", "apps/api/dist/worker.js"]
