# ─── Database ─────────────────────────────────────────────────────────────────
# Local: DATABASE_URL=postgresql://arivarangam:arivarangam@localhost:5432/arivarangam
# Neon (production, $0 idle):
#   DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.aws.neon.tech/arivarangam?pgbouncer=true&connection_limit=1
#   DIRECT_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/arivarangam
DATABASE_URL=postgresql://postgres:password@localhost:5432/arivarangam
DIRECT_URL=postgresql://postgres:password@localhost:5432/arivarangam

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local: REDIS_URL=redis://localhost:6379
# Upstash (production, $0 idle, pay-per-command):
#   REDIS_URL=rediss://default:xxx@xxx.upstash.io:6380
REDIS_URL=redis://localhost:6379

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=3
JWT_SECRET=change-this-to-a-random-32-char-secret-minimum
JWT_EXPIRES_IN=7d
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXX
OPENAI_API_KEY=sk-XXXXXXXXXX
PERPLEXITY_API_KEY=pplx-XXXXXXXXXX
# Gemini — optional, enables Gemini character as code reviewer (get key at aistudio.google.com)
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXX
ELEVENLABS_API_KEY=XXXXXXXXXX

# Razorpay — leave blank until billing is ready
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2 storage
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=XXXXXXXXXX
R2_SECRET_ACCESS_KEY=XXXXXXXXXX
R2_BUCKET_NAME=arivarangam
# Optional: set this if your bucket has public access enabled (e.g. r2.dev subdomain)
R2_PUBLIC_URL=

# Email — Resend (https://resend.com)
# Get your API key from resend.com/api-keys
# FROM_EMAIL must be from a verified domain in your Resend account
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Arivarangam <noreply@arivarangam.com>

CORS_ORIGINS=http://localhost:3000,https://arivarangam.com
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
ADMIN_EMAIL=admin@arivarangam.com
NODE_ENV=development
PORT=3001
ENABLE_SELF_IMPROVE=true
ENABLE_PLATFORM_MONITOR=true
