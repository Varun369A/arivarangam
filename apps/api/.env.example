# ─── Arivarangam API — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in all required values.
# Required = server will crash on startup if missing.
# Optional = has a sensible default; configure before using that feature.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Database (Neon / PostgreSQL) ──────────────────────────────────────────────
# REQUIRED — pooled connection string used by the app at runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# OPTIONAL — direct (non-pooled) connection used by Prisma for migrations
# Only needed on Neon. Falls back to DATABASE_URL when not set.
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
# OPTIONAL — defaults to redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED — minimum 32 characters, random string
JWT_SECRET=

# OPTIONAL — default: 7d
JWT_EXPIRES_IN=7d

# OPTIONAL — AES-256 key for stored user tokens (deploy integrations)
# Falls back to JWT_SECRET if not set. Set explicitly in production.
ENCRYPTION_KEY=

# ── AI APIs ───────────────────────────────────────────────────────────────────
# REQUIRED
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# OPTIONAL — enables Gemini reviewer in task orchestration
GEMINI_API_KEY=

# OPTIONAL — enables voice/audio tasks
ELEVENLABS_API_KEY=

# OPTIONAL — enables Sarvam AI (Indian language tasks)
SARVAM_API_KEY=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# REQUIRED — for email verification, admin OTP, password reset
RESEND_API_KEY=

# OPTIONAL — defaults to "Arivarangam <noreply@arivarangam.com>"
RESEND_FROM=Arivarangam <noreply@arivarangam.com>

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────────
# REQUIRED
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# OPTIONAL — defaults to "arivarangam"
R2_BUCKET_NAME=arivarangam

# OPTIONAL — public URL for serving stored files (e.g. https://pub-xxx.r2.dev)
R2_PUBLIC_URL=

# ── Razorpay (Billing) ────────────────────────────────────────────────────────
# OPTIONAL — configure before enabling billing/payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── App URLs ──────────────────────────────────────────────────────────────────
API_URL=https://api.arivarangam.com
WEB_URL=https://arivarangam.com
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://arivarangam.com,https://www.arivarangam.com

# ── Admin ─────────────────────────────────────────────────────────────────────
# OPTIONAL — email that receives admin OTPs
ADMIN_EMAIL=admin@arivarangam.com

# ── Worker ────────────────────────────────────────────────────────────────────
# OPTIONAL — parallel task slots; default 3
WORKER_CONCURRENCY=3

# ── Deployment Integrations (platform-level fallback tokens) ─────────────────
# OPTIONAL — used when a user has not connected their own account
# Users' own stored tokens take priority over these.
VERCEL_TOKEN=
GITHUB_TOKEN=
RAILWAY_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SUPABASE_ACCESS_TOKEN=

# ── Feature Flags ─────────────────────────────────────────────────────────────
# OPTIONAL — both default to true
ENABLE_SELF_IMPROVE=true
ENABLE_PLATFORM_MONITOR=true
