DATABASE_URL=postgresql://postgres:password@localhost:5432/arivarangam
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-this-to-a-random-32-char-secret-minimum
JWT_EXPIRES_IN=7d
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXX
OPENAI_API_KEY=sk-XXXXXXXXXX
PERPLEXITY_API_KEY=pplx-XXXXXXXXXX
ELEVENLABS_API_KEY=XXXXXXXXXX

# Razorpay — leave blank until billing is ready
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2 storage
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=XXXXXXXXXX
R2_SECRET_ACCESS_KEY=XXXXXXXXXX
R2_BUCKET_NAME=arivarangam
# Optional: set this if your bucket has public access enabled (e.g. r2.dev subdomain)
R2_PUBLIC_URL=

# Email (SMTP) — required for verification emails, password reset, admin OTP
# Gmail: host=smtp.gmail.com port=587 user=youraddress@gmail.com pass=app-password
# (enable 2FA on Gmail, then generate an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=Arivarangam <your@gmail.com>

CORS_ORIGINS=http://localhost:3000,https://arivarangam.com
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
ADMIN_EMAIL=admin@arivarangam.com
NODE_ENV=development
PORT=3001
ENABLE_SELF_IMPROVE=true
ENABLE_PLATFORM_MONITOR=true
