# ─── Arivarangam Web — Environment Variables ─────────────────────────────────
# Copy this file to .env.local (Next.js reads this automatically).
# NEXT_PUBLIC_ vars are embedded into the JS bundle at build time.
# Non-NEXT_PUBLIC_ vars are runtime-only (server-side / middleware).
# ─────────────────────────────────────────────────────────────────────────────

# ── API proxy target (runtime — read by middleware.ts) ────────────────────────
# The web server rewrites /api/* to this URL at runtime.
# REQUIRED in production. Must NOT have a trailing slash.
API_URL=https://api.arivarangam.com

# ── Public API URL (build-time — embedded into client bundle) ────────────────
# Used as a fallback in middleware and for any direct client fetch.
NEXT_PUBLIC_API_URL=https://api.arivarangam.com

# ── Public App URL ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://arivarangam.com

# ── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=production
