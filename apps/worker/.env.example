# ─── Arivarangam Worker — Environment Variables ───────────────────────────────
# The worker shares the same config package as the API.
# Copy this file to .env and fill in all required values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Database (Neon / PostgreSQL) ──────────────────────────────────────────────
# REQUIRED
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# OPTIONAL — direct (non-pooled) for Prisma migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
# OPTIONAL — defaults to redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED — must match the API service's JWT_SECRET exactly
JWT_SECRET=

# ── AI APIs ───────────────────────────────────────────────────────────────────
# REQUIRED
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# OPTIONAL
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
SARVAM_API_KEY=

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────────
# REQUIRED
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# OPTIONAL
R2_BUCKET_NAME=arivarangam
R2_PUBLIC_URL=

# ── App URLs ──────────────────────────────────────────────────────────────────
API_URL=https://api.arivarangam.com
WEB_URL=https://arivarangam.com

# ── Worker Concurrency ────────────────────────────────────────────────────────
# OPTIONAL — number of parallel task slots; default 3
WORKER_CONCURRENCY=3

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_SELF_IMPROVE=true
ENABLE_PLATFORM_MONITOR=true
