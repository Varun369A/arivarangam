# ─── Arrivarangam API Server ──────────────────────────────────────────────────
# Multi-stage build for minimal production image
# Used by Railway for the API service

FROM node:20-alpine AS base
WORKDIR /app
# Install OpenSSL for Prisma
RUN apk add --no-cache openssl

# ─── Dependencies ─────────────────────────────────────────────────────────────
FROM base AS deps
COPY package.json package-lock.json* ./
COPY packages/config/package.json ./packages/config/
COPY packages/db/package.json ./packages/db/
COPY packages/types/package.json ./packages/types/
COPY apps/api/package.json ./apps/api/

# Install all workspace deps
RUN npm ci --workspace=apps/api --workspace=packages/config --workspace=packages/db --workspace=packages/types

# ─── Builder ──────────────────────────────────────────────────────────────────
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Generate Prisma client
RUN npx prisma generate --schema=packages/db/prisma/schema.prisma

# Build shared packages first, then API
RUN npm run build --workspace=packages/config
RUN npm run build --workspace=packages/types
RUN npm run build --workspace=packages/db
RUN npm run build --workspace=apps/api

# ─── Runner ───────────────────────────────────────────────────────────────────
FROM base AS runner
ENV NODE_ENV=production

# Copy built artifacts and node_modules
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/config/dist ./packages/config/dist
COPY --from=builder /app/packages/types/dist ./packages/types/dist
COPY --from=builder /app/packages/db/dist ./packages/db/dist
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Copy Prisma schema + generated client
COPY --from=builder /app/packages/db/prisma ./packages/db/prisma
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# Copy package.json files (needed for workspace resolution)
COPY --from=builder /app/package.json ./
COPY --from=builder /app/packages/config/package.json ./packages/config/
COPY --from=builder /app/packages/types/package.json ./packages/types/
COPY --from=builder /app/packages/db/package.json ./packages/db/
COPY --from=builder /app/apps/api/package.json ./apps/api/

EXPOSE 3001

# Health check — Railway uses this to know when the service is ready
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/health', r => r.statusCode === 200 ? process.exit(0) : process.exit(1)).on('error', () => process.exit(1))"

CMD ["node", "apps/api/dist/server.js"]
